GROQ_API_KEY=your_key_here
PORT=3001

# Optional: extra origins allowed to call /api/analyze cross-origin (comma-separated).
# The deployment's own origin is always allowed.
ALLOWED_ORIGINS=
# Per-IP rate limit for /api/analyze (defaults: 10 requests per 60 seconds).
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=60
# Recommended on Vercel: shared rate-limit store (Upstash Redis or Vercel KV).
# Without it, limits are enforced per serverless instance only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
